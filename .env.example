# ------------------------------------------------------------------
# আদিবার স্মৃতিখানা — environment variables
# Copy this file to `.env.local` (local dev) or set these in Coolify.
# Every value below is explained in README.md.
# ------------------------------------------------------------------

# ---- App ----
# Public URL where the site is reachable (used by the image optimizer).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Site name shown in the header / browser title.
NEXT_PUBLIC_SITE_NAME=আদিবার স্মৃতিখানা

# ---- Auth.js (NextAuth) ----
# Generate a long random string, e.g.: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_URL=http://localhost:3000
# Optional custom credentials signin page (a built-in one is provided).
# AUTH_PAGES_SIGNIN=/login

# ---- PostgreSQL ----
POSTGRES_USER=adiba
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=adiba_memory
DATABASE_URL=postgres://adiba:change-me-strong-password@localhost:5432/adiba_memory

# ---- MinIO (S3-compatible media storage) ----
MINIO_ENDPOINT=http://localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me-minio-access
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=adiba-media
# Only needed when MinIO runs behind a path-prefix proxy:
# MINIO_FORCE_PATH_STYLE=true

# ---- Uploads ----
# Largest single photo/video accepted, in megabytes.
MAX_UPLOAD_MB=200

# ---- Seed script (scripts/seed.ts) — SAMPLE VALUES, change them! ----
SEED_ADMIN_EMAIL=family@example.com
SEED_ADMIN_PASSWORD=change-me-before-going-live
SEED_CHILD_NAME=আয়িশা রহমান
SEED_CHILD_NICKNAME=মিষ্টি

# ---- Dev helpers ----
# Set to 1 to render the site with built-in sample data and NO database at all.
# USE_SAMPLE_DATA=1
